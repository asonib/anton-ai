# Base path for API calls. With the Vite dev proxy, keep the relative default.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:4000
# Colour palette for the whole app (operator-controlled; users can only toggle dark/light).
# One of: jarvis | classic | matrix | cyberpunk   (default: jarvis). Restart the dev server after changing.
VITE_THEME_PALETTE=matrix
