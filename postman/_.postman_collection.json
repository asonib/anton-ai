{
  "info": {
    "_postman_id": "2e9f03ed-0050-4424-8584-947c0275ba1f",
    "name": "Anton AI API (v1)",
    "description": "All backend endpoints of Anton AI, mounted at `/api/v1`.\n\n**Quick start**\n1. Run *Auth \u2192 Register* (or *Login*) \u2014 the JWT is saved to the `token` collection variable automatically.\n2. Every other request inherits `Bearer {{token}}` from the collection.\n3. *Chats \u2192 Send prompt (new conversation)* saves `conversationId`; the multipart request saves `attachmentId`.\n\n**Envelope**\n- Success: `{ success: true, data, meta? }`\n- Error: `{ success: false, error: { code, message, details?, path, timestamp, requestId } }`\n\nOther users' resources return 404. `/auth/register` and `/auth/login` are rate-limited (50 per 15 min).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "email",
      "value": "demo@example.com"
    },
    {
      "key": "password",
      "value": "Password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "attachmentId",
      "value": ""
    },
    {
      "key": "provider",
      "value": "ollama"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness/readiness probe. Public.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create an account. Password: 8\u2013128 chars, at least one letter and one number. Returns `{ token, tokenType, expiresIn, user }` (201). 409 if the e-mail exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "  console.log('Saved JWT for', body.data.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Exchange credentials for a JWT. Saves `token` for the rest of the collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "  console.log('Saved JWT for', body.data.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Profile of the authenticated user. 401 `ACCOUNT_NOT_FOUND` if the token's user no longer exists (e.g. after a DB reset)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Providers",
      "item": [
        {
          "name": "List LLM providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "providers"
              ]
            },
            "description": "Lists `ollama`, `openai`, `anthropic`, `gemini`, `grok` with `{ id, label, model, configured, isDefault }`. Unconfigured providers (missing API key) have `configured: false`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chats",
      "item": [
        {
          "name": "List conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chats?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Paginated list of the current user's conversations. `meta` = `{ total, limit, offset }`. `limit` 1\u2013100 (default 50)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send prompt (new conversation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chats/prompt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "prompt"
              ]
            },
            "description": "Send a prompt to an LLM. Omit `conversationId` to start a new conversation (it is saved to the `conversationId` variable for follow-ups).\n\nBody fields (all optional except `prompt` when no files are attached):\n- `conversationId` \u2014 UUID of an existing conversation\n- `prompt` \u2014 up to 32,000 chars\n- `provider` \u2014 `ollama | openai | anthropic | gemini | grok` (default: `DEFAULT_LLM_PROVIDER`)\n- `model` \u2014 override the provider's configured model\n- `temperature` \u2014 0..2\n\nResponse `data`: `{ conversation, userMessage, assistantMessage, provider, model, usage? }`. This is request/response (no streaming); the first Ollama call can take a while.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain the Strategy pattern in two sentences.\",\n  \"provider\": \"{{provider}}\",\n  \"temperature\": 0.7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('conversationId', body.data.conversation.id);",
                  "  const att = (body.data.userMessage.attachments || [])[0];",
                  "  if (att) pm.collectionVariables.set('attachmentId', att.id);",
                  "  pm.test('Assistant replied', () => pm.expect(body.data.assistantMessage.content).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send prompt (continue conversation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chats/prompt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "prompt"
              ]
            },
            "description": "Follow-up in `{{conversationId}}`. The backend windows the last `CHAT_HISTORY_WINDOW` messages as memory.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"prompt\": \"Now give a TypeScript example.\",\n  \"provider\": \"{{provider}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('conversationId', body.data.conversation.id);",
                  "  const att = (body.data.userMessage.attachments || [])[0];",
                  "  if (att) pm.collectionVariables.set('attachmentId', att.id);",
                  "  pm.test('Assistant replied', () => pm.expect(body.data.assistantMessage.content).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send prompt (override model)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chats/prompt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "prompt"
              ]
            },
            "description": "Same as above but pins a specific model for this call only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"prompt\": \"Summarise our conversation.\",\n  \"provider\": \"grok\",\n  \"model\": \"grok-4\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('conversationId', body.data.conversation.id);",
                  "  const att = (body.data.userMessage.attachments || [])[0];",
                  "  if (att) pm.collectionVariables.set('attachmentId', att.id);",
                  "  pm.test('Assistant replied', () => pm.expect(body.data.assistantMessage.content).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send prompt with attachments (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chats/prompt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "prompt"
              ]
            },
            "description": "`multipart/form-data` variant. Select one or more files in the `files` field (up to `ATTACHMENT_MAX_FILES`, each \u2264 `ATTACHMENT_MAX_FILE_MB`).\n\nImages (PNG/JPEG/GIF/WebP) are sent to the model as image input (needs a vision model); PDF, DOCX, text and code files are extracted to text and folded into the prompt. `prompt` may be empty when files are attached. Saves the first attachment's id to `attachmentId`.\n\nErrors: 413 too large / too many files, 415 unsupported type.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "prompt",
                  "value": "What is in this file?",
                  "type": "text"
                },
                {
                  "key": "provider",
                  "value": "{{provider}}",
                  "type": "text"
                },
                {
                  "key": "conversationId",
                  "value": "",
                  "type": "text",
                  "disabled": true,
                  "description": "Optional \u2014 continue a conversation"
                },
                {
                  "key": "temperature",
                  "value": "",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Pick a file in Postman (repeat the row for multiple files)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('conversationId', body.data.conversation.id);",
                  "  const att = (body.data.userMessage.attachments || [])[0];",
                  "  if (att) pm.collectionVariables.set('attachmentId', att.id);",
                  "  pm.test('Assistant replied', () => pm.expect(body.data.assistantMessage.content).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get conversation messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chats/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "{{conversationId}}",
                "messages"
              ]
            },
            "description": "All messages of a conversation (oldest first), each with attachment metadata (never the bytes). 404 if it isn't yours."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chats/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "{{conversationId}}"
              ]
            },
            "description": "Deletes the conversation with its messages and attachments (cascade). 204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code === 204) pm.collectionVariables.set('conversationId', '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Attachments",
      "item": [
        {
          "name": "Download attachment content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attachments/{{attachmentId}}/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attachments",
                "{{attachmentId}}",
                "content"
              ]
