            "description": "Raw bytes of an attachment you own. Images are served `inline`; everything else as `attachment` (forced download). 404 for other users' files. Use *Send and Download* in Postman for non-images."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error examples",
      "description": "Requests that intentionally fail, to show the error envelope.",
      "item": [
        {
          "name": "Validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`VALIDATION_ERROR` with field-level `details[]`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('Error envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
