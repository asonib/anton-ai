// Prisma schema — MySQL 8. Every Conversation, Message, Attachment, Project and ProjectChange is owned
// by a User (user_id) so all data access can be strictly scoped to the JWT subject.
// Prompts are the exception: the prompt library is shared (readable by every user),
// but only the author may edit or delete their prompt. Favorites are per user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  user
  assistant
}

enum AttachmentKind {
  image
  document
  code
}

enum ProjectSource {
  local
  github
}

enum ProjectChangeAction {
  create
  modify
  delete
}

enum ProjectChangeStatus {
  pending
  applied
  discarded
}

model User {
  id            String         @id @default(uuid()) @db.Char(36)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations Conversation[]
  messages      Message[]
  attachments   Attachment[]
  prompts       Prompt[]
  favorites     PromptFavorite[]
  projects      Project[]
  projectChanges ProjectChange[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// Project attached on the latest prompt (restored by the UI when the thread is reopened).
  projectId String?   @map("project_id") @db.Char(36)
  title     String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId, updatedAt])
  @@index([projectId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Char(36)
  conversationId String       @map("conversation_id") @db.Char(36)
  userId         String       @map("user_id") @db.Char(36)
  role           MessageRole
  content        String       @db.LongText
  provider       String?      @db.VarChar(32)
  modelName      String?      @map("model_name") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
  projectChanges ProjectChange[]

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("messages")
}

/// A file uploaded with a user prompt. Raw bytes are kept so the file can be
/// re-opened from chat history; `extractedText` (documents/code) is what gets
/// injected into the LLM prompt and conversation memory.
model Attachment {
  id            String         @id @default(uuid()) @db.Char(36)
  messageId     String         @map("message_id") @db.Char(36)
  userId        String         @map("user_id") @db.Char(36)
  kind          AttachmentKind
  fileName      String         @map("file_name") @db.VarChar(255)
  mimeType      String         @map("mime_type") @db.VarChar(127)
  sizeBytes     Int            @map("size_bytes")
  data          Bytes          @db.LongBlob
  extractedText String?        @map("extracted_text") @db.LongText
  createdAt     DateTime       @default(now()) @map("created_at")
  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@map("attachments")
}

/// Shared prompt library entry. `authorId = null` marks a built-in prompt synced from
/// `src/config/prompts.config.ts` (matched by `builtInKey`); those cannot be edited via the API.
model Prompt {
  id         String           @id @default(uuid()) @db.Char(36)
  authorId   String?          @map("author_id") @db.Char(36)
  builtInKey String?          @unique @map("built_in_key") @db.VarChar(64)
  title      String           @db.VarChar(120)
  category   String           @db.VarChar(32)
  content    String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  author     User?            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites  PromptFavorite[]

  @@index([authorId])
  @@index([category])
  @@map("prompts")
}

/// A user's favourite prompt (heart). Composite key = one row per user per prompt.
model PromptFavorite {
  userId    String   @map("user_id") @db.Char(36)
  promptId  String   @map("prompt_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([promptId])
  @@map("prompt_favorites")
}

/// A code project attached to the LLM context: a local directory inside one of the operator's
/// WORKSPACE_ROOTS, or a public GitHub repo cloned into PROJECTS_DIR/<userId>/<projectId>.
model Project {
  id            String          @id @default(uuid()) @db.Char(36)
  userId        String          @map("user_id") @db.Char(36)
  name          String          @db.VarChar(120)
  source        ProjectSource
  rootPath      String          @map("root_path") @db.VarChar(1024)
  repoUrl       String?         @map("repo_url") @db.VarChar(512)
  gitRef        String?         @map("git_ref") @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  changes       ProjectChange[]

  @@index([userId, updatedAt])
  @@map("projects")
}

/// One file edit proposed by an assistant message. Nothing touches the disk until the user applies it.
/// `baseHash` is the SHA-256 of the file when the change was proposed (null = file did not exist) and
/// is used to detect conflicting edits; `originalContent` is kept for the diff view and for revert.
model ProjectChange {
  id              String              @id @default(uuid()) @db.Char(36)
  projectId       String              @map("project_id") @db.Char(36)
  messageId       String              @map("message_id") @db.Char(36)
  userId          String              @map("user_id") @db.Char(36)
  path            String              @db.VarChar(1024)
  action          ProjectChangeAction
  status          ProjectChangeStatus @default(pending)
  originalContent String?             @map("original_content") @db.LongText
  newContent      String?             @map("new_content") @db.LongText
  baseHash        String?             @map("base_hash") @db.Char(64)
  createdAt       DateTime            @default(now()) @map("created_at")
  appliedAt       DateTime?           @map("applied_at")
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message         Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([projectId])
  @@index([userId])
  @@map("project_changes")
}
