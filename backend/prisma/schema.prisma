// Prisma schema — MySQL 8. Every Conversation, Message and Attachment is owned
// by a User (user_id) so all data access can be strictly scoped to the JWT subject.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  user
  assistant
}

enum AttachmentKind {
  image
  document
  code
}

model User {
  id            String         @id @default(uuid()) @db.Char(36)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations Conversation[]
  messages      Message[]
  attachments   Attachment[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  title     String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Char(36)
  conversationId String       @map("conversation_id") @db.Char(36)
  userId         String       @map("user_id") @db.Char(36)
  role           MessageRole
  content        String       @db.LongText
  provider       String?      @db.VarChar(32)
  modelName      String?      @map("model_name") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments    Attachment[]

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("messages")
}

/// A file uploaded with a user prompt. Raw bytes are kept so the file can be
/// re-opened from chat history; `extractedText` (documents/code) is what gets
/// injected into the LLM prompt and conversation memory.
model Attachment {
  id            String         @id @default(uuid()) @db.Char(36)
  messageId     String         @map("message_id") @db.Char(36)
  userId        String         @map("user_id") @db.Char(36)
  kind          AttachmentKind
  fileName      String         @map("file_name") @db.VarChar(255)
  mimeType      String         @map("mime_type") @db.VarChar(127)
  sizeBytes     Int            @map("size_bytes")
  data          Bytes          @db.LongBlob
  extractedText String?        @map("extracted_text") @db.LongText
  createdAt     DateTime       @default(now()) @map("created_at")
  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@map("attachments")
}
