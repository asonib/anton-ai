# =====================================================================
#  Anton AI — environment template
#  `npm run setup` copies this file to ./.env (docker compose) and
#  ./backend/.env (API + Prisma). Edit backend/.env afterwards.
# =====================================================================

# ---------- MySQL (docker-compose.yml reads these) ----------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=anton_ai
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_PORT=3306

# Must match the credentials above
DATABASE_URL="mysql://root:password@localhost:3306/anton_ai"

# ---------- API ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------- Auth ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------- LLM orchestration ----------
# ollama | openai | anthropic | gemini
DEFAULT_LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
CHAT_HISTORY_WINDOW=20
# LLM_SYSTEM_PROMPT="You are a helpful assistant..."
# Images from earlier turns re-sent to the model (needs a vision-capable model; 0 = off)
CHAT_HISTORY_IMAGE_LIMIT=2

# ---------- Attachments ----------
# Files are stored in MySQL (LONGBLOB). Images go to the model as image input;
# PDF / DOCX / text / code files are extracted to text and added to the prompt.
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_FILE_MB=10
ATTACHMENT_MAX_TEXT_CHARS=60000

# Ollama (default, local — no key needed). Run `ollama pull llama3.2` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # optional, any OpenAI-compatible gateway

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
