# =====================================================================
#  Anton AI — environment template
#  `npm run setup` copies this file to ./.env (docker compose) and
#  ./backend/.env (API + Prisma). Edit backend/.env afterwards.
# =====================================================================

# ---------- MySQL (docker-compose.yml reads these) ----------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=anton_ai
MYSQL_USER=chatapp
MYSQL_PASSWORD=chatapp_password
MYSQL_PORT=3306

# Must match the credentials above
DATABASE_URL="mysql://chatapp:chatapp_password@localhost:3306/anton_ai"

# ---------- API ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------- Auth ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------- LLM orchestration ----------
# ollama | openai | anthropic | gemini | grok
DEFAULT_LLM_PROVIDER=ollama
# Max time for one model call in ms; 0 = no limit (the model may run as long as it needs).
LLM_TIMEOUT_MS=0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
CHAT_HISTORY_WINDOW=20
# LLM_SYSTEM_PROMPT="You are a helpful assistant..."
# Images from earlier turns re-sent to the model (needs a vision-capable model; 0 = off)
CHAT_HISTORY_IMAGE_LIMIT=2

# ---------- Attachments ----------
# Files are stored in MySQL (LONGBLOB). Images go to the model as image input;
# PDF / DOCX / text / code files are extracted to text and added to the prompt.
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_FILE_MB=10
ATTACHMENT_MAX_TEXT_CHARS=60000

# ---------- Projects (attach a codebase to the chat, review + apply edits) ----------
# Absolute directories users may attach as local projects, separated by ';'.
# Leave empty to disable local projects. Example (Windows): C:\Users\me\code;D:\work
WORKSPACE_ROOTS=
# GitHub clones and new projects are created here as <PROJECTS_DIR>/<name> (clones need `git` on the PATH).
# Default: the first WORKSPACE_ROOTS entry (else backend/data/projects).
# PROJECTS_DIR=
# GIT_BINARY=git
GIT_CLONE_TIMEOUT_MS=120000
# Budget for file tree + file contents sent to the model per prompt (~4 chars per token).
# Small local models (Ollama) need a larger num_ctx for big values.
PROJECT_CONTEXT_MAX_CHARS=120000
PROJECT_MAX_FILE_KB=200
PROJECT_MAX_FILES=5000
# Edits come back as complete files, so project prompts get a bigger output budget.
PROJECT_LLM_MAX_TOKENS=16384

# ---------- Top AI repos (top-right "AI Repos" panel) ----------
# Ranked live from the public GitHub search API, cached in memory.
# GITHUB_API_URL=https://api.github.com
# Optional — any token (no scopes) raises the search limit from 10 to 30 requests/minute.
GITHUB_TOKEN=
AI_REPOS_CACHE_TTL_MS=3600000
AI_REPOS_TIMEOUT_MS=10000

# Ollama (default, local — no key needed). Run `ollama pull llama3.2` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # optional, any OpenAI-compatible gateway

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Thinking mode: auto | adaptive | enabled | disabled.
#   auto (default) — classic request; if the model replies that it needs adaptive thinking, the app
#                    switches that model to adaptive (and drops temperature/top_p/top_k) and retries.
#   adaptive       — newer Claude models (the model decides how much to think).
#   enabled        — older models with extended thinking; uses ANTHROPIC_THINKING_BUDGET tokens.
#   disabled       — no thinking (older models only; newer ones reject it).
ANTHROPIC_THINKING=auto
ANTHROPIC_THINKING_BUDGET=4096
# Optional output_config.effort: low | medium | high | xhigh | max (empty = model default).
ANTHROPIC_EFFORT=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# xAI Grok (OpenAI-compatible API — https://console.x.ai)
XAI_API_KEY=
XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1
